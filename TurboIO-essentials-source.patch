+@main struct RealtimeTests {
+    static func main() throws {
+        assert(SpeechEngine.parakeet.usesParakeet("en-US"))
+        assert(SpeechEngine.parakeet.usesParakeet("en_GB"))
+        assert(!SpeechEngine.parakeet.usesParakeet("yue-HK"))
+        assert(!SpeechEngine.parakeet.usesParakeet("zh-CN"))
+        assert(!SpeechEngine.parakeet.usesParakeet("eng"))
+        assert(!SpeechEngine.apple.usesParakeet("en-US"))
+        var timeline = ParakeetTimeline()
+        let p1 = timeline.ingest("How",final:false,processed:0.32)
+        let p2 = timeline.ingest("How are you?",final:true,processed:1.28)
+        let p3 = timeline.ingest("Next",final:false,processed:1.6)
+        assert(p1.start == p2.start && p2.final && p3.start == p2.end)
+        print("PASS: Parakeet English routing, Apple multilingual routing, stable partial/final segment boundaries")
+        let routes: [String:Any] = ["mode":3,"endpoint":"https://fixture.example/v1/chat/completions","key":"fixture-key","model":"fixture"]
+        assert(AssistantPurpose.cue.provider(routes)["mode"] as? Int == 2)
+        assert(AssistantPurpose.nova.provider(routes)["mode"] as? Int == 2)
+        var independent = routes; independent["cueMode"] = 3; independent["novaMode"] = 2; independent["mode"] = 0
+        assert(AssistantPurpose.cue.provider(independent)["mode"] as? Int == 3)
+        assert(AssistantPurpose.nova.provider(independent)["mode"] as? Int == 2)
+        assert(AssistantPurpose.nova.provider(independent)["endpoint"] as? String == routes["endpoint"] as? String)
+        assert(AssistantPurpose.nova.provider(independent)["key"] as? String == "fixture-key")
+        independent["novaMode"] = 0
+        assert(AssistantPurpose.nova.provider(independent)["mode"] as? Int == 0)
+        print("PASS: independent glasses/Live Cue/Nova routing; local defaults, credentials retained, invalid explicit route never falls back")
+        let locales = ["zh_CN","zh-CN","zh_Hant_TW","yue_HK","yue_Hant_CN"]
+        let unique = SpeechLocalePolicy.unique(locales)
+        assert(unique.count == 4)
+        let labels = unique.map(SpeechLocalePolicy.label)
+        assert(Set(labels).count == 4)
+        assert(SpeechLocalePolicy.label("yue_Hant_HK").hasPrefix("Cantonese"))
+        assert(SpeechLocalePolicy.label("zh_Hant_TW").contains("Traditional"))
+        assert(SpeechLocalePolicy.key("en_US") == SpeechLocalePolicy.key("en-US"))
+        print("PASS: speech locale aliases deduplicated; Chinese/Cantonese region and script labels distinct")
+        var window = TranscriptWindow()
+        _ = window.ingest(.init(start:0,end:1,text:"What is the whether",final:false))
+        assert(window.ingest(.init(start:0,end:1.2,text:"What is the weather?",final:true)) == "What is the weather?")
+        assert(window.ingest(.init(start:0,end:1.2,text:"What is the weather?",final:true)) == "What is the weather?")
+        _ = window.ingest(.init(start:2,end:3,text:"noise",final:false))
+        assert(window.ingest(.init(start:2,end:3,text:"",final:true)) == "What is the weather?")
+        assert(RealtimePolicy.isQuestion("Can you explain this?"))
+        assert(RealtimePolicy.isQuestion("为什么会这样"))
+        assert(!RealtimePolicy.cueCandidate("Okay",final:true))
