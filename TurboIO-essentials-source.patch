+  realtime/ChatGPTAccount.swift realtime/CueService.swift realtime/RealtimeSession.swift \
+  realtime/AppleNavigation.swift realtime/RealtimePanel.swift realtime/NovaPanel.swift \
+  local-translation/src/CaptionAudioPipeline.swift local-translation/src/MicrophoneInput.swift \
+  local-translation/src/HyMTLocalTranslation.swift \
+  local-translation/src/ParakeetSpeech.swift \
+  "$products/FluidAudio.o" "$products/FastClusterWrapper.o" "$products/MachTaskSelfWrapper.o" \
+  "$native/libTurboHyMT.a" "$native/llama-build/src/libllama.a" \
+  "$native/llama-build/ggml/src/libggml.a" "$native/llama-build/ggml/src/libggml-cpu.a" "$native/llama-build/ggml/src/libggml-base.a" \
+  -lc++ -framework Accelerate -framework CoreML -framework AVFoundation \
+  -o build/essentials/TurboRealtime.dylib
+codesign --force --sign - build/essentials/TurboRealtime.dylib
+codesign --verify --strict build/essentials/TurboRealtime.dylib
+xcrun swiftc realtime/RealtimeCore.swift realtime/TokenValidation.swift realtime/ChatGPTFailure.swift realtime/ResponseStream.swift realtime/RealtimeTests.swift -o build/essentials/realtime-tests
+build/essentials/realtime-tests
