+import Foundation
+
+@available(iOS 26.0, *)
+@MainActor final class ChatGPTAnswer: NSObject {
+    private var task: Task<Void, Never>?
+    init(question: String, history: [[String: String]], update: @escaping (String, Bool, String?) -> Void) {
+        super.init()
+        task = Task { @MainActor in
+            do {
+                let account = ChatGPTAccount.shared
+                guard account.isSignedIn else { throw RealtimeError("Open Assistant > ChatGPT account and sign in first.") }
+                guard let model = account.selectedModel, !model.isEmpty else { throw RealtimeError("Choose a model under ChatGPT account first.") }
+                let token = try await account.accessToken()
+                try Task.checkCancellation()
+                let text = try await CueService().streamChatGPT(body: ChatGPTAnswerBody.make(model: model, question: question, history: history), bearer: token, limit: 24000) { text in
+                    guard !Task.isCancelled else { return }; update(text, false, nil)
+                }
+                try Task.checkCancellation(); update(text, true, nil)
+            } catch is CancellationError { }
+            catch { if !Task.isCancelled { update("", true, (error as? RealtimeError)?.message ?? "ChatGPT could not finish this answer. Check the account and connection.") } }
+        }
+    }
+    @objc func cancel() { task?.cancel(); task = nil }
+    deinit { task?.cancel() }
+}
