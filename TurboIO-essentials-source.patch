+NSDictionary *TIORealtimeVoiceCommand(NSString *text, BOOL requirePrefix) {
+    if(![text isKindOfClass:NSString.class]||!text.length||text.length>320)return nil;
+    NSMutableCharacterSet *trim=[NSCharacterSet.whitespaceAndNewlineCharacterSet mutableCopy];
+    [trim addCharactersInString:@",.!?;:，。！？；："];
+    NSString *s=[text stringByTrimmingCharactersInSet:trim];
+    if([s hasPrefix:@"小雷小雷"])s=[[s substringFromIndex:4] stringByTrimmingCharactersInSet:trim];
+    NSMutableArray *words=[NSMutableArray new];
+    for(NSString *w in [s componentsSeparatedByCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet])if(w.length)[words addObject:w];
+    s=[words componentsJoinedByString:@" "];
+    NSString *lower=s.lowercaseString;BOOL prefixed=NO;
+    for(NSString *prefix in @[@"turbo ",@"turbo,",@"turbo，",@"turbo:",@"turbo.",@"turbo!",@"turbo?",@"特博",@"涡轮"]){
+        if([lower hasPrefix:prefix]){s=[[s substringFromIndex:prefix.length] stringByTrimmingCharactersInSet:trim];lower=s.lowercaseString;prefixed=YES;break;}
+    }
+    if(requirePrefix&&!prefixed)return nil;
+    NSDictionary *starts=@{@"start live cue":@"liveCue",@"start live queue":@"liveCue",@"start translation":@"translate",@"start translating":@"translate",@"start captions":@"captions",@"start live captions":@"captions",@"start navigation":@"navigate",@"开始实时提示":@"liveCue",@"开始翻译":@"translate",@"开始字幕":@"captions",@"开始导航":@"navigate"};
+    NSDictionary *stops=@{@"stop live cue":@"liveCue",@"stop live queue":@"liveCue",@"stop translation":@"translate",@"stop translating":@"translate",@"stop captions":@"captions",@"stop live captions":@"captions",@"stop navigation":@"navigate",@"end navigation":@"navigate",@"停止实时提示":@"liveCue",@"停止翻译":@"translate",@"停止字幕":@"captions",@"停止导航":@"navigate"};
+    if(starts[lower])return @{@"action":@"start",@"page":starts[lower]};
+    if(stops[lower])return @{@"action":@"stop",@"page":stops[lower]};
+    if(prefixed&&[@[@"stop",@"stop listening",@"停止"] containsObject:lower])return @{@"action":@"stop",@"page":@"all"};
+    if([@[@"cue now",@"answer this question",@"立即提示"] containsObject:lower])return @{@"action":@"ask",@"page":@"liveCue"};
+    if([@[@"open navigation",@"打开导航"] containsObject:lower])return @{@"action":@"open",@"page":@"navigate"};
+    // Destination text remains user data. Never infer or automatically select a place.
+    for(NSString *prefix in @[@"navigate to ",@"导航到"]){
+        if([lower hasPrefix:prefix]){NSString *query=[[s substringFromIndex:prefix.length] stringByTrimmingCharactersInSet:trim];if(query.length>=2&&query.length<=200)return @{@"action":@"search",@"page":@"navigate",@"query":query};}
+    }
+    return nil;
+}
+BOOL TIOHasRealtimeVoicePrefix(NSString *text) {
+    if(![text isKindOfClass:NSString.class])return NO;
+    NSString *s=[[text stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet] lowercaseString];
+    if([s isEqual:@"turbo"])return YES;
+    for(NSString *prefix in @[@"turbo ",@"turbo,",@"turbo，",@"turbo:",@"turbo.",@"turbo!",@"turbo?",@"特博",@"涡轮"])if([s hasPrefix:prefix])return YES;
+    return NO;
+}
