+#import "Core.h"
+#import "ResearchCatalog.h"
+#include <assert.h>
+
+int main(void) {
+    @autoreleasepool {
+        // Commands are complete utterances; discussing a command must not close
+        // the conversation. Run this against the actual essentials compilation.
+        assert(TIOIsVoiceExitCommand(@" Stop listening! "));
+        assert(TIOIsVoiceExitCommand(@"END CONVERSATION."));
+        assert(!TIOIsVoiceExitCommand(@"When should I stop listening?"));
+        assert(!TIOIsVoiceExitCommand(@"Please explain the phrase end conversation."));
+        assert(!TIOIsVoiceExitCommand(@"stop"));
+        assert(!TIOIsVoiceExitCommand(@""));
+        assert([TIORealtimeVoiceCommand(@" Start Live Cue! ",NO)[@"page"] isEqual:@"liveCue"]);
+        assert([TIORealtimeVoiceCommand(@"Turbo, start translation.",NO)[@"action"] isEqual:@"start"]);
+        assert([TIORealtimeVoiceCommand(@"Turbo stop captions",YES)[@"page"] isEqual:@"captions"]);
+        assert([TIORealtimeVoiceCommand(@"Turbo stop",YES)[@"page"] isEqual:@"all"]);
+        assert([TIORealtimeVoiceCommand(@"特博停止翻译",YES)[@"page"] isEqual:@"translate"]);
+        assert([TIORealtimeVoiceCommand(@"小雷小雷，开始字幕。",NO)[@"page"] isEqual:@"captions"]);
+        assert([TIORealtimeVoiceCommand(@"navigate to Central Park",NO)[@"query"] isEqual:@"Central Park"]);
+        assert([TIORealtimeVoiceCommand(@"Turbo, navigate to St. Mary's Hospital",YES)[@"query"] isEqual:@"St. Mary's Hospital"]);
+        assert([TIORealtimeVoiceCommand(@"start navigation",NO)[@"action"] isEqual:@"start"]);
+        assert([TIORealtimeVoiceCommand(@"Turbo, cue now",YES)[@"action"] isEqual:@"ask"]);
+        assert([TIORealtimeVoiceCommand(@"Turbo. Stop translation.",YES)[@"page"] isEqual:@"translate"]);
+        for(NSString *text in @[@"",@"start",@"stop",@"Can you start translation?",@"Explain start live cue",@"Do not start captions",@"start translation and send my location",@"Turbo navigate to ",@"Turbocharged start captions",@"I said Turbo stop translation",@"\"start translation\""])
+            assert(!TIORealtimeVoiceCommand(text,NO));
+        assert(!TIORealtimeVoiceCommand(@"start translation",YES));
+        assert(!TIORealtimeVoiceCommand(@"stop listening",YES));
+        assert(TIOHasRealtimeVoicePrefix(@" Turbo, st"));
+        assert(TIOHasRealtimeVoicePrefix(@"TURBO"));
+        assert(TIOHasRealtimeVoicePrefix(@"Turbo."));
+        assert(!TIOHasRealtimeVoicePrefix(@"Turbocharged engines"));
+        assert(!TIOHasRealtimeVoicePrefix(@"Explain the Turbo command"));
+        NSSet *removed=[NSSet setWithArray:@[@"agent",@"knowledge",@"navigation",@"capture",@"archive",@"search",@"searchKey",@"searchTest",@"todoTest",@"ttsKey",@"ttsEngine",@"thinking",@"experimentalOTA"]];
+        NSMutableSet *seen=[NSMutableSet new];
+        for(NSString *page in @[@"model",@"voice",@"diagnostics"]) {
+            NSArray *sections=TIOResearchSections(page);assert(sections.count);
+            for(NSDictionary *section in sections)for(NSDictionary *row in section[@"rows"]) {
+                NSString *key=row[@"key"];assert(![removed containsObject:key]);assert(![seen containsObject:key]);[seen addObject:key];
+            }
+        }
+        assert([seen containsObject:@"api"]&&[seen containsObject:@"tts"]&&[seen containsObject:@"status"]);
+        assert(TIOResearchSections(@"library").count==0);
+        NSDictionary *request=TIOChatRequest(@"test-model",@"Hello");
+        assert(request&&[request[@"stream"] boolValue]);
+        assert([request[@"messages"][0][@"content"] containsString:@"English"]);
+        NSLog(@"PASS: essentials routes, voice commands, prefix guards and false-trigger rejection");
+    }
+    return 0;
+}
