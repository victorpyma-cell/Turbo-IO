+static NSUInteger TIOWakePrefixLength(NSString *lower) {
+    NSMutableCharacterSet *boundary=[NSCharacterSet.whitespaceAndNewlineCharacterSet mutableCopy];
+    [boundary addCharactersInString:@",.!?;:，。！？；："];
+    for(NSString *word in @[@"hey nova",@"ok nova",@"okay nova",@"nova",@"n",@"q",@"cue",@"queue",@"turbo",@"特博",@"涡轮"]){
+        if(![lower hasPrefix:word])continue;
+        if([word isEqual:@"特博"]||[word isEqual:@"涡轮"]||lower.length==word.length)return word.length;
+        if([boundary characterIsMember:[lower characterAtIndex:word.length]])return word.length;
+    }
+    return 0;
+}
