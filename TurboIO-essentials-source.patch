+++ b/official-addon/realtime/RealtimeCore.swift
@@ -0,0 +1,123 @@
+import Foundation
+
+// Pure policy shared with the macOS replay tests. No microphone or network here.
+enum RealtimePolicy {
+    static func clean(_ value: String) -> String {
+        value.split(whereSeparator: { $0.isWhitespace }).joined(separator: " ")
+    }
+    static func isQuestion(_ value: String) -> Bool {
+        let s = clean(value).lowercased()
+        if s.count < 4 { return false }
+        if s.contains("?") || s.contains("？") { return true }
+        let prefixes = ["what ", "why ", "how ", "when ", "where ", "who ", "which ",
+                        "can you ", "could you ", "would you ", "do you ", "does ",
+                        "is it ", "are you ", "tell me ", "explain ", "describe ",
+                        "什么", "为什么", "怎么", "如何", "请问", "请解释"]
+        return prefixes.contains { s.hasPrefix($0) }
+    }
+    static func cueCandidate(_ value: String, final: Bool) -> Bool {
+        let s = clean(value)
+        return s.count >= 8 && (isQuestion(s) || (final && s.count >= 18))
+    }
+    static func hud(_ value: String, bytes: Int = 360) -> String {
+        var out = ""
+        for c in value {
+            if out.utf8.count + String(c).utf8.count > bytes - 3 { return out + "…" }
+            out.append(c)
+        }
+        return out
+    }
+}
+
+struct TranscriptPiece: Equatable {
+    let start: Double
+    let end: Double
+    let text: String
+    let final: Bool
+}
+
+struct TranscriptWindow {
+    private(set) var pieces: [TranscriptPiece] = []
+    mutating func ingest(_ piece: TranscriptPiece) -> String {
+        guard piece.start.isFinite, piece.end.isFinite, piece.end >= piece.start else { return text }
+        // Volatile ranges replace overlapping guesses; they are never appended as new speech.
+        pieces.removeAll { !$0.final && $0.start < piece.end + 0.001 && $0.end > piece.start - 0.001 }
+        if !pieces.contains(where: { $0.final && abs($0.start-piece.start) < 0.001 && abs($0.end-piece.end) < 0.001 }) {
+            pieces.append(piece)
+        }
+        pieces.sort { $0.start < $1.start }
+        if pieces.count > 24 { pieces.removeFirst(pieces.count-24) }
+        return text
+    }
+    var text: String { RealtimePolicy.clean(pieces.map(\.text).joined(separator: " ")) }
+    mutating func reset() { pieces.removeAll() }
+}
+
+struct UtteranceWindow {
+    private var window = TranscriptWindow()
+    private var lastEnd = 0.0
+    private var boundary = false
+    mutating func ingest(_ piece: TranscriptPiece) -> String {
+        if piece.start > lastEnd+0.85 || (boundary && piece.start >= lastEnd-0.001) || window.text.count > 1500 {
+            window.reset(); boundary = false
+        }
+        let text = window.ingest(piece)
+        lastEnd = max(lastEnd,piece.end)
+        if piece.final, let last = text.last { boundary = ".!?。！？".contains(last) }
+        return text
+    }
+}
+
+// Speech can finalize "Turbo," separately from "stop translation". Keep a
+// short command window independent of sentence punctuation and normal captions.
+struct VoiceCommandWindow {
+    private var window = TranscriptWindow()
+    private var began: Double?
+    private var lastEnd = 0.0
+    private var consumedEnd = -1.0
+    mutating func ingest(_ piece: TranscriptPiece, prefixed: Bool) -> String? {
+        guard piece.start.isFinite, piece.end.isFinite, piece.end >= piece.start else { return nil }
+        if piece.end <= consumedEnd + 0.001 { return "" }
+        if let began, piece.start > lastEnd + 1.2 || piece.end - began > 6 {
+            self.began = nil; window.reset()
+        }
+        if began == nil {
+            guard prefixed else { return nil }
+            began = piece.start; window.reset()
+        }
+        lastEnd = max(lastEnd,piece.end)
+        return window.ingest(piece)
+    }
+    mutating func consume() {
+        consumedEnd = lastEnd; began = nil; window.reset()
+    }
+}
+
+struct XY: Equatable { let x: Double; let y: Double }
+struct RouteProjection {
+    let distance: Double
+    let progress: Double
+}
+enum RouteGeometry {
+    static func needsReroute(_ projection: RouteProjection?, accuracy: Double, walking: Bool) -> Bool {
+        guard let projection else { return true }
+        return projection.distance > max(walking ? 45 : 65,accuracy*1.5)
+    }
+    static func project(_ p: XY, points: [XY], previous: Double?, lookAhead: Double) -> RouteProjection? {
+        guard points.count > 1 else { return nil }
+        var cumulative = 0.0
+        var best: RouteProjection?
+        for i in 1..<points.count {
+            let a = points[i-1], b = points[i], dx = b.x-a.x, dy = b.y-a.y
+            let length = hypot(dx,dy)
+            defer { cumulative += length }
+            guard length > 0.01 else { continue }
+            let t = max(0, min(1, ((p.x-a.x)*dx+(p.y-a.y)*dy)/(length*length)))
+            let along = cumulative+t*length
+            if let previous, along < previous-45 || along > previous+lookAhead { continue }
+            let candidate = RouteProjection(distance: hypot(p.x-a.x-t*dx,p.y-a.y-t*dy), progress: along)
+            if best == nil || candidate.distance < best!.distance-0.5 { best = candidate }
+        }
+        return best
+    }
+}
