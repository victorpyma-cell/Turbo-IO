+        } message: { Text(session.showOnGlasses ? "End any active recording, Live Cue, translation, or navigation on the glasses. Once they show the home screen, tap Start." : "End any other recording in the RayNeo app, then tap Start. This session will show text on the phone.") }
+        .sheet(isPresented:$prepareTranslation) { LanguagePreparation(source:session.source,target:session.target) }
+    }
+}
