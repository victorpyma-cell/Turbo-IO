+
+@main struct RealtimeTests {
+    static func main() throws {
+        var window = TranscriptWindow()
+        _ = window.ingest(.init(start:0,end:1,text:"What is the whether",final:false))
+        assert(window.ingest(.init(start:0,end:1.2,text:"What is the weather?",final:true)) == "What is the weather?")
+        assert(window.ingest(.init(start:0,end:1.2,text:"What is the weather?",final:true)) == "What is the weather?")
+        _ = window.ingest(.init(start:2,end:3,text:"noise",final:false))
+        assert(window.ingest(.init(start:2,end:3,text:"",final:true)) == "What is the weather?")
+        assert(RealtimePolicy.isQuestion("Can you explain this?"))
+        assert(RealtimePolicy.isQuestion("为什么会这样"))
+        assert(!RealtimePolicy.cueCandidate("Okay",final:true))
+        assert(RealtimePolicy.cueCandidate("Explain how this works",final:false))
+        assert(!RealtimePolicy.cueCandidate("That sounds interesting",final:false))
+        assert(RealtimePolicy.hud(String(repeating:"翻译🙂",count:200)).utf8.count <= 360)
+        var utterance = UtteranceWindow()
+        _ = utterance.ingest(.init(start:0,end:1,text:"Can you tell me",final:true))
+        assert(utterance.ingest(.init(start:1.1,end:2,text:"how this works?",final:false)) == "Can you tell me how this works?")
+        assert(utterance.ingest(.init(start:1.1,end:2,text:"how this works?",final:true)) == "Can you tell me how this works?")
+        assert(utterance.ingest(.init(start:3,end:4,text:"Next question",final:false)) == "Next question")
+        var commands = VoiceCommandWindow()
+        assert(commands.ingest(.init(start:0,end:1,text:"Ordinary speech",final:true),prefixed:false) == nil)
+        assert(commands.ingest(.init(start:1.1,end:1.5,text:"Turbo,",final:true),prefixed:true) == "Turbo,")
+        assert(commands.ingest(.init(start:1.6,end:2,text:"stop translating",final:false),prefixed:false) == "Turbo, stop translating")
+        assert(commands.ingest(.init(start:1.6,end:2.1,text:"stop translation",final:true),prefixed:false) == "Turbo, stop translation")
+        commands.consume()
+        assert(commands.ingest(.init(start:1.6,end:2.1,text:"stop translation",final:true),prefixed:false) == "")
+        assert(commands.ingest(.init(start:2.2,end:3,text:"Conversation resumes",final:true),prefixed:false) == nil)
+        _ = commands.ingest(.init(start:4,end:4.5,text:"Turbo,",final:true),prefixed:true)
+        assert(commands.ingest(.init(start:6,end:7,text:"unrelated speech",final:true),prefixed:false) == nil)
+        _ = commands.ingest(.init(start:8,end:8.5,text:"Turbo,",final:true),prefixed:true)
+        assert(commands.ingest(.init(start:8.6,end:15,text:"very long discussion",final:true),prefixed:false) == nil)
+        let line = [XY(x:0,y:0),XY(x:100,y:0),XY(x:100,y:100)]
+        let projection = RouteGeometry.project(XY(x:75,y:5),points:line,previous:20,lookAhead:150)!
+        assert(abs(projection.progress-75)<0.001 && abs(projection.distance-5)<0.001)
+        assert(RouteGeometry.project(XY(x:100,y:90),points:line,previous:10,lookAhead:30) == nil)
+        assert(RouteGeometry.project(XY(x:0,y:0),points:[],previous:nil,lookAhead:100) == nil)
+        let behind = RouteGeometry.project(XY(x:5,y:0),points:line,previous:190,lookAhead:100)
+        assert(behind == nil)
+        assert(RouteGeometry.needsReroute(behind,accuracy:10,walking:true))
+        assert(!RouteGeometry.needsReroute(projection,accuracy:10,walking:true))
+        assert(RouteGeometry.needsReroute(.init(distance:80,progress:10),accuracy:10,walking:false))
+
+        // Reject forged, expired, wrong-audience and wrong-nonce ID tokens.
+        let key = P256.Signing.PrivateKey()
+        let raw = key.publicKey.x963Representation
+        let jwk: [String:Any] = ["kid":"fixture","alg":"ES256","kty":"EC","crv":"P-256","x":TokenValidation.base64URL(raw.subdata(in:1..<33)),"y":TokenValidation.base64URL(raw.subdata(in:33..<65))]
+        let claims: [String:Any] = ["iss":"https://auth.openai.com","sub":"fixture-user","aud":"fixture-client","exp":2000,"iat":900,"nonce":"fixture-nonce"]
+        func token(_ claims: [String:Any]) throws -> String {
+            let head = TokenValidation.base64URL(try JSONSerialization.data(withJSONObject:["alg":"ES256","kid":"fixture"]))
+            let body = TokenValidation.base64URL(try JSONSerialization.data(withJSONObject:claims))
+            let signature = try key.signature(for:Data((head+"."+body).utf8))
+            return head+"."+body+"."+TokenValidation.base64URL(signature.rawRepresentation)
+        }
+        let valid = try token(claims)
+        let verified = try TokenValidation.verify(valid,jwks:[jwk],audience:"fixture-client",nonce:"fixture-nonce",now:1000)
+        assert(verified["sub"] as? String == "fixture-user")
+        func rejects(_ token: String, audience: String = "fixture-client", nonce: String = "fixture-nonce", now: Double = 1000) {
+            do { _ = try TokenValidation.verify(token,jwks:[jwk],audience:audience,nonce:nonce,now:now); fatalError("Accepted invalid token") } catch {}
+        }
+        rejects(valid,audience:"different-client"); rejects(valid,nonce:"wrong"); rejects(valid,now:3000)
+        var forged = valid.split(separator:".").map(String.init); forged[1] = TokenValidation.base64URL(Data("{}".utf8)); rejects(forged.joined(separator:"."))
+        print("PASS: transcript revisions, split voice commands, question triggers, UTF-8 display limits, off-route recovery and ID-token validation")
+    }
+}
