@@ -0,0 +1,119 @@
+// Included by Addon.m so the small settings surface shares its existing
+// Keychain, request cancellation, and compatibility guards.
+@interface TIOPanel : UITableViewController
+@property(nonatomic,copy) NSString *page;
+@property(nonatomic) NSArray<NSDictionary *> *sections;
+@property(nonatomic) TIORequest *testRequest;
+@end
+
+@implementation TIOPanel
+- (void)viewDidLoad {
+    [super viewDidLoad];
+    self.sections=TIOResearchSections(self.page);
+    self.title=@{@"model":@"Assistant",@"voice":@"Voice",@"diagnostics":@"Status"}[self.page];
+    TIOStyleResearchTable(self);
+}
+- (void)viewWillAppear:(BOOL)animated {[super viewWillAppear:animated];[self.tableView reloadData];}
+- (void)viewDidDisappear:(BOOL)animated {[super viewDidDisappear:animated];[self.testRequest cancel];self.testRequest=nil;}
+- (void)dealloc {[_testRequest cancel];}
+- (NSInteger)numberOfSectionsInTableView:(UITableView *)tableView {return self.sections.count;}
+- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section {return [self.sections[section][@"rows"] count];}
+- (NSString *)tableView:(UITableView *)tableView titleForHeaderInSection:(NSInteger)section {return self.sections[section][@"title"];}
+- (NSString *)tableView:(UITableView *)tableView titleForFooterInSection:(NSInteger)section {
+    if([self.page isEqual:@"model"]&&section==0)return @"Controls ordinary RayNeo voice answers. Live Cue can also use this custom API, or your connected ChatGPT account.";
+    if([self.page isEqual:@"model"]&&section==1)return @"On-device captions and translation use the iPhone microphone. Navigation uses Apple Maps. Requires iOS 26 or later.";
+    if([self.page isEqual:@"model"]&&section==2)return @"Context stays in memory and resets when the app closes.";
+    if([self.page isEqual:@"voice"]&&section==0)return @"English speech generated on the iPhone. Requires connected Bluetooth headphones or another supported audio output; a glasses display alone cannot play sound.";
+    if([self.page isEqual:@"voice"]&&section==1)return @"Say “end conversation” or “stop listening” as a complete command.";
+    if([self.page isEqual:@"diagnostics"]&&section==0)return @"This checks app compatibility. Pairing and device status remain in the RayNeo app.";
+    if([self.page isEqual:@"diagnostics"]&&section==1)return @"Sends a short test question to your configured provider. It does not test the glasses display.";
+    return nil;
+}
+- (UITableViewCell *)tableView:(UITableView *)tableView cellForRowAtIndexPath:(NSIndexPath *)ip {
+    NSDictionary *row=self.sections[ip.section][@"rows"][ip.row];NSString *key=row[@"key"];
+    UITableViewCell *cell=[[UITableViewCell alloc]initWithStyle:UITableViewCellStyleSubtitle reuseIdentifier:nil];
+    cell.textLabel.text=row[@"title"];cell.imageView.image=[UIImage systemImageNamed:row[@"icon"]];
+    cell.imageView.tintColor=UIColor.systemIndigoColor;cell.accessibilityIdentifier=[@"essentials-" stringByAppendingString:key];
+    cell.accessoryType=UITableViewCellAccessoryDisclosureIndicator;TIOStyleResearchCell(cell);
+    if([key isEqual:@"mode"])cell.detailTextLabel.text=[Prefs integerForKey:@"mode"]==2?@"Custom API":@"RayNeo";
+    if([key isEqual:@"api"])cell.detailTextLabel.text=[Prefs stringForKey:@"model"].length?[Prefs stringForKey:@"model"]:@"Not configured";
+    if([key isEqual:@"history"])cell.detailTextLabel.text=[NSString stringWithFormat:@"%lu messages in this session",(unsigned long)[Controller.history snapshot].count];
+    if([key isEqual:@"tts"]||[key isEqual:@"exit"]){
+        BOOL speech=[key isEqual:@"tts"];UISwitch *toggle=[UISwitch new];
+        toggle.on=[Prefs boolForKey:speech?@"ttsEnabled":@"voiceExitCommands"];
+        [toggle addTarget:self action:speech?@selector(toggleSpeech:):@selector(toggleExit:) forControlEvents:UIControlEventValueChanged];
+        cell.accessoryView=toggle;cell.selectionStyle=UITableViewCellSelectionStyleNone;
+        if(!speech&&!VoiceExitReady){toggle.enabled=NO;cell.detailTextLabel.text=@"Unavailable for this app version";}
+    }
+    if([key isEqual:@"ttsTest"])cell.detailTextLabel.text=@"Plays one short phrase";
+    if([key isEqual:@"status"]){cell.detailTextLabel.text=HooksReady?@"Compatible host; voice callbacks ready":@"Host mismatch; custom voice hooks disabled";cell.accessoryType=UITableViewCellAccessoryNone;cell.selectionStyle=UITableViewCellSelectionStyleNone;}
+    if([key isEqual:@"apiTest"])cell.detailTextLabel.text=self.testRequest?@"Testing…":@"Manual connection test";
+    return cell;
+}
+- (void)toggleSpeech:(UISwitch *)toggle {[VoiceTTS cancel];[Prefs setBool:toggle.on forKey:@"ttsEnabled"];}
+- (void)toggleExit:(UISwitch *)toggle {[Prefs setBool:toggle.on forKey:@"voiceExitCommands"];}
+- (void)configureProvider {
+    UIAlertController *dialog=[UIAlertController alertControllerWithTitle:@"Custom API" message:@"Enter a full HTTPS chat/completions endpoint. The API key stays in the iPhone Keychain. Leave it blank to keep the key for the same endpoint." preferredStyle:UIAlertControllerStyleAlert];
+    [dialog addTextFieldWithConfigurationHandler:^(UITextField *field){field.placeholder=@"https://provider.example/v1/chat/completions";field.text=[Prefs stringForKey:@"endpoint"];field.keyboardType=UIKeyboardTypeURL;}];
+    [dialog addTextFieldWithConfigurationHandler:^(UITextField *field){field.placeholder=@"Model ID";field.text=[Prefs stringForKey:@"model"];}];
+    [dialog addTextFieldWithConfigurationHandler:^(UITextField *field){field.placeholder=@"API key";field.secureTextEntry=YES;}];
+    for(UITextField *field in dialog.textFields){field.autocorrectionType=UITextAutocorrectionTypeNo;field.autocapitalizationType=UITextAutocapitalizationTypeNone;}
+    [dialog addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
+    __weak typeof(self) weak=self;
+    [dialog addAction:[UIAlertAction actionWithTitle:@"Save" style:UIAlertActionStyleDefault handler:^(UIAlertAction *action){
+        NSURL *url=TIOValidateEndpoint(dialog.textFields[0].text?:@"");NSString *model=[dialog.textFields[1].text stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet]?:@"";
+        NSString *key=dialog.textFields[2].text?:@"";dialog.textFields[2].text=@"";
+        if(!url||!TIOChatRequest(model,@"Hello")||key.length>4096||[key rangeOfCharacterFromSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].location!=NSNotFound){Alert(@"Not saved",@"Check the endpoint, model ID, and API key.");return;}
+        if(key.length&&!StoreKey(url.absoluteString,key)){Alert(@"Not saved",@"The Keychain could not save the key.");return;}
+        if(!ReadKey(url.absoluteString).length){Alert(@"Not saved",@"This endpoint needs an API key.");return;}
+        BOOL changed=![[Prefs stringForKey:@"endpoint"] isEqual:url.absoluteString]||![[Prefs stringForKey:@"model"] isEqual:model]||key.length;
+        [Controller cancel];if(changed)[Controller.history clear];
+        [Prefs setObject:url.absoluteString forKey:@"endpoint"];[Prefs setObject:model forKey:@"model"];
+        // Editing configuration preserves the user's current provider selection.
+        [weak.tableView reloadData];
+    }]];
+    [self presentViewController:dialog animated:YES completion:nil];
+}
+- (void)chooseProvider {
+    UIAlertController *dialog=[UIAlertController alertControllerWithTitle:@"Answer provider" message:nil preferredStyle:UIAlertControllerStyleActionSheet];
+    __weak typeof(self) weak=self;
+    [dialog addAction:[UIAlertAction actionWithTitle:@"RayNeo" style:UIAlertActionStyleDefault handler:^(UIAlertAction *action){[Controller cancel];[Prefs setInteger:0 forKey:@"mode"];[weak.tableView reloadData];}]];
+    [dialog addAction:[UIAlertAction actionWithTitle:@"Custom API" style:UIAlertActionStyleDefault handler:^(UIAlertAction *action){
+        NSString *endpoint=[Prefs stringForKey:@"endpoint"]?:@"";
+        if(!HooksReady){Alert(@"Unavailable",@"This app version does not match the verified voice interface.");return;}
+        if(!TIOValidateEndpoint(endpoint)||!TIOChatRequest([Prefs stringForKey:@"model"]?:@"",@"Hello")||!ReadKey(endpoint).length){Alert(@"Set up your provider",@"Save your custom API settings first.");return;}
+        [Controller cancel];[Prefs setInteger:2 forKey:@"mode"];[weak.tableView reloadData];
+    }]];
+    [dialog addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
+    dialog.popoverPresentationController.sourceView=self.view;dialog.popoverPresentationController.sourceRect=CGRectMake(self.view.bounds.size.width/2,100,1,1);
+    [self presentViewController:dialog animated:YES completion:nil];
+}
+- (void)clearContext {
+    UIAlertController *dialog=[UIAlertController alertControllerWithTitle:@"Clear conversation context?" message:@"This clears the custom assistant's in-memory history and cancels its current answer." preferredStyle:UIAlertControllerStyleAlert];
+    [dialog addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
+    __weak typeof(self) weak=self;
+    [dialog addAction:[UIAlertAction actionWithTitle:@"Clear" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *action){[Controller cancel];[Controller.history clear];[weak.tableView reloadData];}]];
+    [self presentViewController:dialog animated:YES completion:nil];
+}
+- (void)testProvider {
+    [self.testRequest cancel];TIORequest *request=[TIORequest new];self.testRequest=request;
+    __weak typeof(self) weak=self;__weak TIORequest *expected=request;
+    request.update=^(NSString *text,BOOL done,NSString *error){
+        typeof(self) strong=weak;if(!strong||strong.testRequest!=expected||!done)return;
+        strong.testRequest=nil;[strong.tableView reloadData];Alert(error?@"Connection test failed":@"Provider replied",error?:text);
+    };
+    [self.tableView reloadData];[request startQuestion:@"Reply with one short English sentence confirming this connection test."];
+}
+- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)ip {
+    [tableView deselectRowAtIndexPath:ip animated:YES];NSString *key=self.sections[ip.section][@"rows"][ip.row][@"key"];
+    if([key isEqual:@"mode"])[self chooseProvider];
+    else if([@[@"liveCue",@"translate",@"navigate",@"chatgpt"] containsObject:key]){
+        [Controller cancel];[VoiceTTS cancel];
+        TIOOpenRealtime(self,key,^NSDictionary *{NSString *endpoint=[Prefs stringForKey:@"endpoint"]?:@"";return @{@"endpoint":endpoint,@"model":[Prefs stringForKey:@"model"]?:@"",@"key":ReadKey(endpoint)?:@""};});
+    }
+    else if([key isEqual:@"api"])[self configureProvider];
+    else if([key isEqual:@"history"])[self clearContext];
+    else if([key isEqual:@"apiTest"])[self testProvider];
+    else if([key isEqual:@"ttsTest"]){[VoiceTTS beginTurn];[VoiceTTS appendFullText:@"Turbo IO local speech is working." finished:YES];}
+}
+@end
