+            } footer: {
+                Text(session.mode == .cue ? "Live Cue sends recognized text to your connected ChatGPT account or custom API. Audio stays on the iPhone. No recordings or transcript files are saved." : "Speech and translation run on the iPhone after language downloads. No recordings or transcript files are saved.")
+            }
+            Section("Live captions") { Text(session.captions.isEmpty ? "Speech appears here as it is recognized." : session.captions).textSelection(.enabled).accessibilityIdentifier("realtime-captions") }
+            if session.mode != .captions {
+                Section(session.mode == .cue ? "Suggested cue" : "Translation") {
+                    Text(session.output.isEmpty ? "Waiting for speech…" : session.output).font(.title3).textSelection(.enabled).accessibilityIdentifier("realtime-output")
+                    if !session.timing.isEmpty { Text(session.timing).font(.caption).foregroundStyle(.secondary) }
+                }
+            }
+            Section("Voice commands") {
+                Text("Wake the glasses assistant, then say start Live Cue, start translation, or start captions. Keep RayNeo AI open on the iPhone. Prepare languages and your answer provider first.")
+                Text("While listening in English, say Turbo, stop translation; Turbo, stop captions; Turbo, stop Live Cue; or Turbo, stop. Say Turbo, cue now for the current question. Chinese controls include 特博停止翻译 and 特博停止. Other speech languages use the on-screen controls.")
+            }.font(.footnote)
+            Section { Text("One glasses session at a time, up to 20 minutes. Starting the glasses voice assistant ends the current Turbo session. Leaving this page ends the session; audio or connection interruptions also stop it.").font(.footnote).foregroundStyle(.secondary) }
+        }
