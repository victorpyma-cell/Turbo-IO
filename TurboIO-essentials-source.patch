+++ b/official-addon/realtime/LocalSpeech.swift
@@ -0,0 +1,105 @@
+import Foundation
+import Speech
+import AVFAudio
+import CoreMedia
+
+enum CaptionFailure: Error { case configuration, unavailable, routeChanged }
+struct RealtimeError: LocalizedError {
+    let message: String
+    init(_ message: String) { self.message = message }
+    var errorDescription: String? { message }
+}
+
+@available(iOS 26.0, *)
+@MainActor final class LocalSpeech {
+    var onText: ((TranscriptPiece) -> Void)?
+    var onFailure: ((String) -> Void)?
+    private let microphone = CaptionMicrophoneInput()
+    private var analyzer: SpeechAnalyzer?
+    private var input: AsyncStream<AnalyzerInput>.Continuation?
+    private var results: Task<Void, Never>?
+    private var generation = 0
+    private var starting = false
+    private(set) var inputName = "iPhone microphone"
+
+    static func languages() async -> [Locale] {
+        guard SpeechTranscriber.isAvailable else { return [] }
+        return await SpeechTranscriber.supportedLocales.sorted { $0.identifier < $1.identifier }
+    }
+    func prepareLanguage(_ identifier: String) async throws {
+        guard SpeechTranscriber.isAvailable,
+              let locale = await SpeechTranscriber.supportedLocale(equivalentTo: Locale(identifier: identifier)) else {
+            throw RealtimeError("On-device speech is unavailable for this device or language.")
+        }
+        let module = SpeechTranscriber(locale: locale, transcriptionOptions: [], reportingOptions: [.volatileResults], attributeOptions: [.audioTimeRange])
+        if let request = try await AssetInventory.assetInstallationRequest(supporting: [module]) {
+            try await request.downloadAndInstall()
+        }
+    }
+    func start(language: String) async throws {
+        guard analyzer == nil, !starting else { throw RealtimeError("A speech session is already active.") }
+        starting = true
+        defer { starting = false }
+        generation += 1; let epoch = generation
+        guard SpeechTranscriber.isAvailable,
+              let locale = await SpeechTranscriber.supportedLocale(equivalentTo: Locale(identifier: language)) else {
+            throw RealtimeError("This speech language is not supported on this iPhone.")
+        }
+        guard await SpeechTranscriber.installedLocales.contains(where: { $0.identifier == locale.identifier }) else {
+            throw RealtimeError("Tap Prepare speech language first to download Apple's on-device model.")
+        }
+        try Task.checkCancellation()
+        guard epoch == generation else { throw CancellationError() }
+        let module = SpeechTranscriber(locale: locale, transcriptionOptions: [], reportingOptions: [.volatileResults], attributeOptions: [.audioTimeRange])
+        guard let format = await SpeechAnalyzer.bestAvailableAudioFormat(compatibleWith: [module]) else {
+            throw RealtimeError("The speech model is not ready. Prepare the selected language again.")
+        }
+        let analyzer = SpeechAnalyzer(modules: [module])
+        self.analyzer = analyzer
+        do {
+            try await analyzer.prepareToAnalyze(in: format)
+            guard epoch == generation else { throw CancellationError() }
+            let ports = try await microphone.prepare()
+            guard epoch == generation else { throw CancellationError() }
+            // A RayNeo proprietary Opus stream is not an iOS microphone. Select the
+            // known built-in input explicitly instead of silently taking another route.
+            guard let port = ports.first(where: { $0.type == AVAudioSession.Port.builtInMic.rawValue }) else {
+                throw RealtimeError("The iPhone microphone is unavailable. End the other recording or call.")
+            }
+            inputName = port.name
+            let (sequence, continuation) = AsyncStream<AnalyzerInput>.makeStream(bufferingPolicy: .bufferingOldest(8))
+            input = continuation
+            microphone.onBuffer = { [weak self] buffer in
+                guard let self, self.generation == epoch else { return }
+                if case .dropped = continuation.yield(AnalyzerInput(buffer: buffer)) {
+                    self.fail("Speech processing fell behind. Restart the session.", epoch: epoch)
+                }
+            }
+            microphone.onFailure = { [weak self] _ in self?.fail("The microphone route changed or audio was interrupted. Restart when ready.", epoch: epoch) }
+            results = Task { [weak self] in
+                do {
+                    for try await result in module.results {
+                        guard let self, self.generation == epoch, !Task.isCancelled else { return }
+                        let range = result.range
+                        self.onText?(TranscriptPiece(start: CMTimeGetSeconds(range.start), end: CMTimeGetSeconds(CMTimeRangeGetEnd(range)), text: String(result.text.characters), final: result.isFinal))
+                    }
+                } catch { if !Task.isCancelled { self?.fail("On-device speech stopped. Restart the session.", epoch: epoch) } }
+            }
+            try await analyzer.start(inputSequence: sequence)
+            guard epoch == generation else { throw CancellationError() }
+            try await microphone.start(uid: port.uid, format: format)
+        } catch { await stop(); throw error }
+    }
+    func stop() async {
+        generation += 1
+        microphone.stop(); input?.finish(); input = nil
+        results?.cancel(); results = nil
+        let previous = analyzer; analyzer = nil
+        await previous?.cancelAndFinishNow()
+    }
+    private func fail(_ message: String, epoch: Int) {
+        guard epoch == generation else { return }
+        generation += 1; microphone.stop(); input?.finish(); input = nil
+        onFailure?(message)
+    }
+}
